#!name=G1 Pro Annual Test
#!desc=Titik masuk kompatibilitas v7.6.0: Merujuk ke skrip 3 paket G1 ACQ yang sama, mendukung uji coba gratis 1 bulan Ultra (20TB g1.20tb.1month_eft.acq, 30TB g1.ai.ultra.1month_eft.acq) dengan fallback independen cadangan 90p 3 bulan; target uji promo 12 bulan 2TB g1.2tb.ai.12months_ip_90p (tanpa .acq); mengumpulkan secara pasif pada cakupan /ai? dan mendukung diagnostik 10 respons terakhir/penambahan baru/duplikat; modul utama saat ini adalah g1-acq-v7.sgmodule, cukup aktifkan satu; bukan kueri aktif seluruh SKU
#!system=ios

[Rule]
# Sama seperti modul lama: memblokir UDP 443 pada lalu lintas yang menggunakan konfigurasi ini.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
