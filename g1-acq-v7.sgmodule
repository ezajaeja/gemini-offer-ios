#!name=G1 ACQ Plus (Pro 18M/15M/12M Free & Ultra 1M Free)
#!desc=v8.0.0: Penambahan uji coba gratis $0 Pro 5TB 18 bulan/15 bulan/12 bulan (g1.2tb.ai.18months_eft, dll.), uji coba gratis 12 bulan AI Plus 2TB/400GB, mendukung penggantian target SKU 1-klik di panel kontrol lokal Safari (https://one.google.com/g1-sku-report); sekaligus mendukung uji coba gratis 1 bulan Ultra 20TB/30TB serta fallback otomatis diskon 90% (90p) 3 bulan. Dikembangkan dari crhywun/g1-acq.
#!system=ios

[Rule]
# Memblokir UDP 443 agar permintaan HTTP/3 yang mendukung fallback beralih ke TCP.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ezajaeja/gemini-offer-ios/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/ezajaeja/gemini-offer-ios/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
